{
  "version": 2,
  "goals": {
    "check": [
      "check-legacy-sheet",
      "check-analytics",
      "check-state",
      "check-runtime",
      "check-test",
      "check-build",
      "check-report"
    ],
    "test": [
      "test"
    ],
    "build": [
      "build-release"
    ]
  },
  "operations": {
    "check-state": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "src/state.mjs"
        ]
      }
    },
    "check-runtime": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "src/monitor.mjs"
        ]
      }
    },
    "check-test": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "tests/test-cli.mjs"
        ]
      }
    },
    "check-build": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "scripts/build-release.mjs"
        ]
      }
    },
    "test": {
      "prerequisites": [
        "check-analytics",
        "check-state",
        "check-runtime",
        "check-test",
        "check-report"
      ],
      "action": {
        "type": "process",
        "command": "npm",
        "args": [
          "test"
        ]
      }
    },
    "build-release": {
      "prerequisites": [
        "test",
        "check-build"
      ],
      "outputs": {
        "artifact": {
          "path": "dist/release-artifact"
        }
      },
      "action": {
        "type": "process",
        "command": "npm",
        "args": [
          "run",
          "build"
        ]
      }
    },
    "check-analytics": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "src/analytics.mjs"
        ]
      }
    },
    "check-legacy-sheet": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "src/legacy-sheet.mjs"
        ]
      }
    },
    "check-report": {
      "action": {
        "type": "process",
        "command": "node",
        "args": [
          "--check",
          "src/report.mjs"
        ]
      }
    }
  }
}
